@page "/Colectas/Edit/{IdColecta:int}"
@rendermode InteractiveServer
@inject ColectasService colectasService
@inject ToastService toastService

<PageTitle> Modificar Colecta</PageTitle>

<EditForm Model="Colecta" OnValidSubmit="Modificar">
    <DataAnnotationsValidator />
    <div class="container">
        <div class="card shadow-lg">
            <div class="card-header text-center">
                <h5 class="card-title mt-2"> Modificar Colecta </h5>
            </div>

            <div class="card-body">
                @*IdColecta*@
                <div class="mb-3">
                    <label class="form-label"><strong>Id</strong></label>
                    <InputNumber class="form-control" @bind-Value="Colecta.AporteId" readonly></InputNumber>
                </div>

                @*Fecha*@
                <div class="mb-3">
                    <label class="form-label"><strong>Fecha</strong></label>
                    <InputDate class="form-control" @bind-Value="Colecta.Fecha"></InputDate>
                    <ValidationMessage For="() => Colecta.Fecha" />
                </div>

                @*Nombres*@
                <div class="mb-3">
                    <label class="form-label"><strong>Nombres</strong></label>
                    <InputText class="form-control" @bind-Value="Colecta.Nombres"></InputText>
                    <ValidationMessage For="() => Colecta.Nombres" />
                </div>

                @*Monto*@
                <div class="mb-3">
                    <label class="form-label"><strong>Monto</strong></label>
                    <InputNumber class="form-control" @bind-Value="Colecta.Monto"></InputNumber>
                    <ValidationMessage For="() => Colecta.Monto" />
                </div>

                <div class="card-footer text-center mr-3">
                    <a href="/Colectas/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
                    <button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
                    <button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminacion"> Eliminar</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

<div class="modal fade" id="modalEliminacion" tabindex="-1" aria-labelledby="modalCerrar" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="modalCerrar">Confirmacion de Eliminicaci&oacute;n</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                @if (Colecta != null)
                {
                    <p>¿Desea eliminar el aporte de @Colecta.Nombres?</p>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" @onclick="Eliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public int IdColecta { get; set; }
    public Colectas Colecta = new Colectas();

    protected override async Task OnInitializedAsync()
    {
        var ColectaEncontrada = await colectasService.Buscar(IdColecta);
        if (ColectaEncontrada != null)
        {
            Colecta = ColectaEncontrada;
        }
    }

    private async Task Modificar()
    {
        bool guardado = await colectasService.Guardar(Colecta);

        if (guardado)
        {
            toastService.ShowSuccess("Colecta Guardada Exitosamente");
            navigationManager.NavigateTo("/Colectas/Index");
        }
        else
        {
            toastService.ShowError("Error al Guardar la Colecta");
        }
    }

    private async Task Eliminar()
    {
        bool eliminado = await colectasService.Eliminar(Colecta.AporteId);

        if (eliminado)
        {
            toastService.ShowSuccess("Colecta Eliminada Exitosamente");
            navigationManager.NavigateTo("/Colectas/Index");
        }
        else
        {
            toastService.ShowError("Error al Eliminar la Colecta");
        }
    }
}
